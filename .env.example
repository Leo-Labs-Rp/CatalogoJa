# Supabase — obrigatórias no modo básico (valores públicos)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
# Aceita a Publishable key atual (sb_publishable_...) ou a chave anon legada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL canônica da aplicação — obrigatória para callbacks e magic links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demonstração pública somente leitura — opcional; habilitada por padrão
DEMO_ACCESS_ENABLED=true

# Supabase Admin — opcional sem Asaas; somente servidor
# Aceita uma Secret key atual (sb_secret_...) ou a service_role legada.
# Nunca use NEXT_PUBLIC_ neste valor.
SUPABASE_SERVICE_ROLE_KEY=

# Asaas — somente servidor
ASAAS_API_KEY=
# Segredo próprio do webhook (32 a 255 caracteres), diferente da API key.
ASAAS_WEBHOOK_TOKEN=
# Opcional para chaves legadas. Chaves atuais hmlg/prod selecionam a URL automaticamente.
ASAAS_API_URL=
# O checkout recorrente atual usa cartão de crédito. PIX recorrente exige outro fluxo.

# Resend — opcional; usado apenas no e-mail de boas-vindas após provisionamento
RESEND_API_KEY=
RESEND_FROM_EMAIL="CatalogoJá <onboarding@resend.dev>"
